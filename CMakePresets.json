{
	"version": 3,
	"configurePresets": [
		{
			"name": "default",
			"displayName": "Default Config",
			"description": "Default build with Debug configuration",
			"generator": "Unix Makefiles",
			"binaryDir": "${sourceDir}/build",
			"cacheVariables": {
				"CMAKE_BUILD_TYPE": "Debug",
				"CMAKE_COLOR_DIAGNOSTICS": "ON"
			},
			"environment": {
				"CMAKE_COLOR_DIAGNOSTICS": "ON"
			}
		},
		{
			"name": "release",
			"displayName": "Release Config",
			"description": "Release build with optimizations",
			"generator": "Unix Makefiles",
			"binaryDir": "${sourceDir}/build-release",
			"cacheVariables": {
				"CMAKE_BUILD_TYPE": "Release",
				"CMAKE_COLOR_DIAGNOSTICS": "ON"
			},
			"environment": {
				"CMAKE_COLOR_DIAGNOSTICS": "ON"
			}
		}
	],
	"buildPresets": [
		{
			"name": "default",
			"configurePreset": "default",
			"displayName": "Build Default",
			"description": "Build with default config"
		},
		{
			"name": "release",
			"configurePreset": "release",
			"displayName": "Build Release",
			"description": "Build with release config"
		},
		{
			"name": "pytest-minimal",
			"configurePreset": "default",
			"displayName": "Build for Pytest Minimal",
			"description": "Build then run pytest with minimal output"
		},
		{
			"name": "pytest-verbose",
			"configurePreset": "default",
			"displayName": "Build for Pytest Verbose",
			"description": "Build then run pytest with verbose output"
		},
		{
			"name": "pytest-full",
			"configurePreset": "default",
			"displayName": "Build for Pytest Full",
			"description": "Build then run pytest with full output"
		}
	],
	"testPresets": [
		{
			"name": "minimal",
			"configurePreset": "default",
			"displayName": "Test Minimal",
			"description": "Minimal test output (1/1 style)",
			"output": {
				"outputOnFailure": true
			},
			"execution": {
				"noTestsAction": "error",
				"stopOnFailure": false
			}
		},
		{
			"name": "verbose",
			"configurePreset": "default",
			"displayName": "Test Verbose",
			"description": "Verbose test output with test names",
			"output": {
				"outputOnFailure": true,
				"verbosity": "verbose"
			},
			"execution": {
				"noTestsAction": "error",
				"stopOnFailure": false
			}
		},
		{
			"name": "full-output",
			"configurePreset": "default",
			"displayName": "Test Full Output",
			"description": "Full test output with print statements",
			"output": {
				"outputOnFailure": true,
				"verbosity": "extra"
			},
			"execution": {
				"noTestsAction": "error",
				"stopOnFailure": false
			}
		},
		{
			"name": "pytest-minimal",
			"configurePreset": "default",
			"displayName": "Pytest Minimal",
			"description": "Run pytest directly with minimal output",
			"output": {
				"outputOnFailure": true
			},
			"execution": {
				"noTestsAction": "error",
				"stopOnFailure": false
			}
		},
		{
			"name": "pytest-verbose",
			"configurePreset": "default",
			"displayName": "Pytest Verbose",
			"description": "Run pytest directly with verbose output",
			"output": {
				"outputOnFailure": true
			},
			"execution": {
				"noTestsAction": "error",
				"stopOnFailure": false
			}
		},
		{
			"name": "pytest-full",
			"configurePreset": "default",
			"displayName": "Pytest Full Output",
			"description": "Run pytest directly with full output and prints",
			"output": {
				"outputOnFailure": true
			},
			"execution": {
				"noTestsAction": "error",
				"stopOnFailure": false
			}
		}
	]
}